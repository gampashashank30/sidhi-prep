# ──────────────────────────────────────────────────────────────────────────────
# Siddhi Prep — Environment Variables
# Copy this file to .env.local and fill in all values before running locally.
# NEVER commit .env.local — it is listed in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Public-facing base URL (no trailing slash). Used in email links.
# Local development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000

# ── Session ──────────────────────────────────────────────────────────────────
# Must be a cryptographically random string, minimum 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-very-long-random-session-secret-at-least-32-chars

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# IMPORTANT: Use the SERVICE ROLE key (not the anon/public key).
# This key bypasses Row Level Security and must ONLY be used server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Use a Gmail account + App Password (NOT your normal Gmail password).
# Steps to get App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Then go to myaccount.google.com/apppasswords
#   3. Create an app password → copy the 16-character code
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Siddhi Prep

# ── Admin Seed (only needed when running: npm run seed:admin) ─────────────────
# Remove these after the initial admin has been created.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password-min-12-chars
